#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T          &kp Y        &kp U        &kp I        &kp O        &kp P        &kp BSPC
&kp ESC    &kp A    &kp S    &kp D    &kp F    &kp G          &kp H        &kp J        &kp K        &kp L        &kp SEMI     &kp DEL
&kp LSHFT  &kp Z    &kp X    &kp C    &kp V    &kp B          &kp N        &kp M        &kp COMMA    &kp DOT      &kp SLASH    &kp RSHFT
                              &mt LCTRL ESC   &lt 1 SPACE   &mt LALT TAB    &mt RGUI ENTER   &lt 2 BSPC   &mt RCTRL DEL
            >;
            label = "BASE";
        };

        num_nav_layer {
            bindings = <
&trans      &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT      &kp HOME     &kp N7       &kp N8       &kp N9       &kp MINUS    &trans
&trans      &kp AMPS &kp STAR &kp LPAR &kp RPAR &kp EQUAL      &kp END      &kp N4       &kp N5       &kp N6       &kp PLUS     &trans
&trans      &kp LBKT &kp RBKT &kp LBRC &kp RBRC &kp BSLH       &kp LEFT     &kp N1       &kp N2       &kp N3       &kp UP       &trans
                              &trans         &trans         &trans            &kp N0          &kp DOT        &kp RIGHT
            >;
            label = "NUM_NAV";
        };

        sym_layer {
            bindings = <
&kp GRAVE   &kp EXCL &kp AT   &kp HASH &kp DLLR &kp PRCNT      &kp CARET    &kp AMPS     &kp STAR     &kp MINUS    &kp PLUS     &trans
&kp TILDE   &kp LT   &kp GT   &kp LPAR &kp RPAR &kp PIPE       &kp LBRC     &kp RBRC     &kp LBKT     &kp RBKT     &kp COLON    &kp DQT
&trans      &kp BSLH &kp SLASH &kp EQUAL &kp UNDER &kp QMARK   &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT    &kp SQT      &trans
                              &trans         &trans         &trans            &kp ENTER       &trans        &trans
            >;
            label = "SYM";
        };

        fn_bt_layer {
            bindings = <
&kp F1      &kp F2   &kp F3   &kp F4   &kp F5   &kp F6         &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR   &trans
&kp F7      &kp F8   &kp F9   &kp F10  &kp F11  &kp F12        &kp PG_UP    &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_MUTE   &trans
&trans      &trans   &trans   &trans   &trans   &trans         &kp PG_DN    &kp C_VOL_DN &kp C_VOL_UP &trans       &trans       &trans
                              &trans         &mo 3           &to 0             &trans          &trans        &trans
            >;
            label = "FN_BT";
        };
    };
};
